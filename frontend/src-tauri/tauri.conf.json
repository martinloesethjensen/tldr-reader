{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TLDR Reader",
  "version": "1.2.0",
  "identifier": "dev.martinloeseth.tldr-reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TLDR Reader",
        "width": 1000,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/martinloesethjensen/tldr-reader/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["../../target/release/tldr-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQ0EwRDBCMkEyMDY1RTAKUldUZ1pTQXFDdzNLVTNOTUVXS2pPb0FkelJFK3BYQjgzMjlrZ0JzTVdtcW5QNVgxdnV1UmtjS0oK",
      "endpoints": [
        "https://github.com/martinloesethjensen/tldr-reader/releases/latest/download/latest.json"
      ]
    }
  }
}
